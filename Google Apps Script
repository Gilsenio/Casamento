// Função para obter lista de convidados E multimedia
function doGet(e) {
  try {
    // Se tem parâmetro action=submit, processar como POST
    if (e.parameter.action === 'submit') {
      return handleSubmit(e.parameter);
    }

    // Retornar lista de convidados + multimedia
    const guestSheet =
      SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Convidados');
    const guestData = guestSheet.getDataRange().getValues();

    const guests = {};
    for (let i = 1; i < guestData.length; i++) {
      const phone = normalizePhone(guestData[i][0].toString());
      if (phone) {
        guests[phone] = {
          name: guestData[i][1],
          maxGuests: parseInt(guestData[i][2]) || 1,
          code: guestData[i][3]?.toString().toUpperCase().trim() || '',
          confirmed: guestData[i][4] === 'SIM',
        };
      }
    }

    // Buscar dados de multimedia
    const multimedia = getMultimediaData();

    return ContentService.createTextOutput(
      JSON.stringify({
        success: true,
        guests: guests,
        multimedia: multimedia,
      }),
    ).setMimeType(ContentService.MimeType.JSON);
  } catch (error) {
    return ContentService.createTextOutput(
      JSON.stringify({ success: false, error: error.toString() }),
    ).setMimeType(ContentService.MimeType.JSON);
  }
}

// Buscar dados de multimedia
function getMultimediaData() {
  try {
    let multSheet =
      SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Multimedia');

    // Se a aba não existe, criar com dados padrão
    if (!multSheet) {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      multSheet = ss.insertSheet('Multimedia');
      multSheet.appendRow(['Tipo', 'URL', 'Descrição']);
      multSheet.appendRow([
        'musica',
        'https://www.dropbox.com/scl/fi/fyg9h4pmq2l93j0b6jqw0/Ed-Sheeran-Thinking-Out-Loud-Official-Music-Video.mp3?rlkey=m0fktn9hx6hnp7bjf9lo0q5g3&st=fdg22ekc&dl=1',
        'Nossa música',
      ]);
      multSheet.appendRow([
        'foto',
        'https://images.unsplash.com/photo-1606800052052-a08af7148866?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
        'Foto padrão 1',
      ]);
      multSheet.appendRow([
        'foto',
        'https://images.unsplash.com/photo-1542415719-96b33a38d73d?q=80&w=1470&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D',
        'Foto padrão 2',
      ]);
      multSheet.appendRow([
        'foto',
        'https://images.unsplash.com/photo-1519741497674-611481863552?w=800&h=600&fit=crop',
        'Alianças de casamento',
      ]);
      multSheet.appendRow([
        'foto',
        'https://images.unsplash.com/photo-1465495976277-4387d4b0b4c6?w=800&h=600&fit=crop',
        'Casal apaixonado',
      ]);
      multSheet.appendRow([
        'foto',
        'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?w=800&h=600&fit=crop',
        'Buquê de flores',
      ]);
      multSheet.appendRow([
        'foto',
        'https://images.unsplash.com/photo-1606800052052-a08af7148866?w=800&h=600&fit=crop',
        'Decoração do casamento',
      ]);
    }

    const data = multSheet.getDataRange().getValues();
    const multimedia = {
      musicas: [],
      fotos: [],
    };

    for (let i = 1; i < data.length; i++) {
      const tipo = data[i][0].toString().toLowerCase().trim();
      let url = data[i][1].toString().trim();
      const descricao = data[i][2].toString().trim();

      if (!url) continue;

      // ===== PROCESSAR URLs =====

      // 1. Dropbox: Converter dl=0 para dl=1
      if (url.includes('dropbox.com') && url.includes('dl=0')) {
        url = url.replace('dl=0', 'dl=1');
      }

      // 2. Google Drive: Converter para formato de download direto
      if (url.includes('drive.google.com/file/d/')) {
        const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/);
        if (match && match[1]) {
          url = `https://drive.google.com/uc?export=download&id=${match[1]}`;
        }
      }

      // 3. Unsplash: Converter para URL de imagem direta
      if (
        url.includes('unsplash.com/') &&
        !url.includes('images.unsplash.com')
      ) {
        // Extrair ID da foto
        const photoMatch = url.match(/fotografias\/[^\/]+-([a-zA-Z0-9_-]+)/);
        if (photoMatch && photoMatch[1]) {
          url = `https://images.unsplash.com/photo-${photoMatch[1]}?w=800`;
        }
      }

      // Adicionar à lista apropriada
      if (tipo === 'musica' && url) {
        multimedia.musicas.push({ url: url, descricao: descricao });
      } else if (tipo === 'foto' && url) {
        multimedia.fotos.push({ url: url, descricao: descricao });
      }
    }

    return multimedia;
  } catch (error) {
    Logger.log('Erro ao buscar multimedia: ' + error);
    return { musicas: [], fotos: [] };
  }
}

// Processar confirmação via POST
function doPost(e) {
  try {
    const data = JSON.parse(e.postData.contents);
    return processConfirmation(data);
  } catch (error) {
    return ContentService.createTextOutput(
      JSON.stringify({ success: false, error: error.toString() }),
    ).setMimeType(ContentService.MimeType.JSON);
  }
}

// Processar confirmação via GET
function handleSubmit(params) {
  try {
    const data = JSON.parse(decodeURIComponent(params.data));
    return processConfirmation(data);
  } catch (error) {
    return ContentService.createTextOutput(
      JSON.stringify({ success: false, error: error.toString() }),
    ).setMimeType(ContentService.MimeType.JSON);
  }
}

// Processar a confirmação
function processConfirmation(data) {
  try {
    let confirmSheet =
      SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Confirmações');

    if (!confirmSheet) {
      const ss = SpreadsheetApp.getActiveSpreadsheet();
      confirmSheet = ss.insertSheet('Confirmações');
      confirmSheet.appendRow([
        'Data/Hora',
        'Telefone',
        'Nome',
        'Vai_Comparecer',
        'Total_Pessoas',
        'Acompanhantes',
        'Restrições',
        'Mensagem',
      ]);
    }

    confirmSheet.appendRow([
      new Date(),
      data.phone,
      data.name,
      data.attendance === 'yes' ? 'SIM' : 'NÃO',
      data.numAccompanists,
      data.accompanists.join(', '),
      data.dietary || '',
      data.message || '',
    ]);

    updateGuestStatus(data.phone);
    sendNotificationEmail(data);

    return ContentService.createTextOutput(
      JSON.stringify({ success: true }),
    ).setMimeType(ContentService.MimeType.JSON);
  } catch (error) {
    return ContentService.createTextOutput(
      JSON.stringify({ success: false, error: error.toString() }),
    ).setMimeType(ContentService.MimeType.JSON);
  }
}

// Atualizar status do convidado
function updateGuestStatus(phone) {
  const sheet =
    SpreadsheetApp.getActiveSpreadsheet().getSheetByName('Convidados');
  const data = sheet.getDataRange().getValues();
  const normalizedPhone = normalizePhone(phone);

  for (let i = 1; i < data.length; i++) {
    if (normalizePhone(data[i][0].toString()) === normalizedPhone) {
      sheet.getRange(i + 1, 4).setValue('SIM');
      break;
    }
  }
}

// Normalizar telefone
function normalizePhone(phone) {
  return phone
    .toString()
    .replace(/[\s\-+]/g, '')
    .replace(/^351/, '');
}

